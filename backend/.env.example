PORT=4000
NODE_ENV=development

# ---- Chain ----
# Hardhat local node: 31337 | Sepolia: 11155111
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# ---- Deployed contracts (from contracts/deployments/<network>.json) ----
ROLE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ANNOUNCEMENT_LOG_ADDRESS=0x0000000000000000000000000000000000000000
DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ACK_LOG_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Auth (SIWE-like wallet sign-in) ----
JWT_SECRET=replace-me-with-long-random-string
APP_DOMAIN=localhost
BACKEND_DOMAIN=localhost

# Optional: restrict CORS and chain IDs
# FRONTEND_ORIGIN=http://localhost:5173
# ALLOWED_CHAIN_IDS=31337,11155111

# ---- Transaction relay ----
# When set, backend submits publish/register/acknowledge txs on behalf of users.
# Must hold PROFESSOR_ROLE (publish/register) or STUDENT_ROLE (acknowledge) on-chain.
# Hardhat account #0 example (local dev only):
# BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d5d76055b51adf99573d3df1541455d8ac7be9f

# Legacy alias (prefer BACKEND_PRIVATE_KEY):
# PRIVATE_KEY=

# ---- AI Assistant (RAG) ----
# Optional: OpenAI for chat + embeddings (otherwise local Xenova embeddings + context-only answers)
# OPENAI_API_KEY=sk-...
# RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local embedding model (Hugging Face id, downloaded on first index/query)
# RAG_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Vector index JSON path (default: ../rag/data/index.json)
# RAG_INDEX_PATH=

# Retrieval / chunking tuning
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=120

# ---- Telegram bot / automation (extension bonus) ----
# Shared secret: same value in telegram-bot/.env (or run: .\scripts\setup-telegram.ps1)
BACKEND_SERVICE_TOKEN=daa-local-demo-service-token-change-me
# Wallet impersonated for RAG when the bot calls POST /api/chat (prof démo après grant-roles:local)
BOT_SERVICE_WALLET_ADDRESS=0x7F48fa16c4535Bc00Ce6315E377F93787B95319F
# Alternative étudiant Hardhat #2 : 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ---- Optional ----
# Override Hardhat artifact path if contracts live elsewhere
# CONTRACTS_ARTIFACTS_DIR=../contracts/artifacts/contracts/core
